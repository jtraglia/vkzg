// Cell bytes -> bit-reversed Fr values, for cell recovery's input. Mirrors
// k_blob_to_fr.comp's conversion (32 big-endian bytes -> Montgomery Fr) and
// k_compress_proofs.comp's bit-reversal convention, applied per field
// element across the full extended domain (8192 = 128 cells * 64 elements)
// rather than per blob. Missing cells' bytes are never checked for
// canonicity -- the recovery math zeroes them out regardless of value.
#version 460
#extension GL_GOOGLE_include_directive : require
#include "field.glsl.inc"

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant, std430) uniform PC {
    uint64_t outAddr;
    uint64_t cellsAddr;
} pc;

void main() {
    U32Buf outBuf = U32Buf(pc.outAddr);
    U8Buf cellsBuf = U8Buf(pc.cellsAddr);

    const uint i = gl_GlobalInvocationID.x;
    const uint b = gl_GlobalInvocationID.y;
    if (i >= L_FIELD_ELEMENTS_PER_EXT_BLOB) return;
    const uint srcBase = b * L_FIELD_ELEMENTS_PER_EXT_BLOB * 32u + i * 32u;

    Fr v;
    [[unroll]] for (int limb = 0; limb < FR_NLIMBS; limb++) {
        const uint off = uint(7 - limb) * 4u;
        v.v[limb] = (uint(cellsBuf.v[srcBase + off]) << 24) |
                    (uint(cellsBuf.v[srcBase + off + 1]) << 16) |
                    (uint(cellsBuf.v[srcBase + off + 2]) << 8) | uint(cellsBuf.v[srcBase + off + 3]);
    }
    const Fr m = fr_from_canonical(v);
    const uint dst = brev(i, 13u);
    fr_store(outBuf, (b * L_FIELD_ELEMENTS_PER_EXT_BLOB + dst) * FR_NLIMBS, m);
}
