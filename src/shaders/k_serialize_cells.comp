// evaluations -> cell bytes.
#version 460
#extension GL_GOOGLE_include_directive : require
#include "field.glsl.inc"

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant, std430) uniform PC {
    uint64_t outAddr;
    uint64_t evalsAddr;
} pc;

void main() {
    U8Buf outBuf = U8Buf(pc.outAddr);
    U32Buf evalsBuf = U32Buf(pc.evalsAddr);

    const uint i = gl_GlobalInvocationID.x;
    const uint b = gl_GlobalInvocationID.y;
    Fr v = fr_load(evalsBuf, (b * L_FIELD_ELEMENTS_PER_EXT_BLOB + i) * FR_NLIMBS);
    v = fr_to_canonical(v);
    const uint dst = brev(i, L_LOG_EXT_BLOB);
    const uint obase = b * (L_FIELD_ELEMENTS_PER_EXT_BLOB * 32u) + dst * 32u;
    for (int limb = 0; limb < FR_NLIMBS; limb++) {
        const uint w = v.v[limb];
        const uint off = uint(7 - limb) * 4u;
        outBuf.v[obase + off + 0] = uint8_t(w >> 24);
        outBuf.v[obase + off + 1] = uint8_t(w >> 16);
        outBuf.v[obase + off + 2] = uint8_t(w >> 8);
        outBuf.v[obase + off + 3] = uint8_t(w);
    }
}
