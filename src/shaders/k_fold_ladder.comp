// Folds the 128-position doubling ladder into the two 64-position ladders
// phase B's split form needs (see layout_defs.h): L+[j][d] = L[j][d] +
// L[j+64][d], L-[j][d] = L[j][d] - L[j+64][d].
//
// Writes into a separate buffer rather than folding in place: for j < 64 the
// output slot aliases one of the two input slots it reads, so in-place
// folding would race against itself.
#version 460
#extension GL_GOOGLE_include_directive : require
#include "field.glsl.inc"

layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;

layout(push_constant, std430) uniform PC {
    uint64_t outAddr;
    uint64_t ladderAddr;
} pc;

void main() {
    U32Buf outBuf = U32Buf(pc.outAddr);
    U32Buf ladderBuf = U32Buf(pc.ladderAddr);

    // gl_GlobalInvocationID.x packs (j, d): j in [0,64), d in [0,32).
    const uint jd = gl_GlobalInvocationID.x;
    const uint j = jd / L_LADDER_POSITIONS;
    const uint d = jd % L_LADDER_POSITIONS;
    const uint b = gl_GlobalInvocationID.y;

    const uint blobBase = b * L_CIRCULANT_SIZE * L_LADDER_POSITIONS * L_JACOBIAN_WORDS;
    const uint lo = blobBase + (j * L_LADDER_POSITIONS + d) * L_JACOBIAN_WORDS;
    const uint hi = blobBase + ((j + L_CIRCULANT_HALF) * L_LADDER_POSITIONS + d) * L_JACOBIAN_WORDS;

    const G1 a = g1_load(ladderBuf, lo);
    const G1 c = g1_load(ladderBuf, hi);
    g1_store(outBuf, lo, g1_add(a, c));
    g1_store(outBuf, hi, g1_sub(a, c));
}
