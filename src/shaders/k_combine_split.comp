// Reconstructs the 128 circulant outputs from phase B's split halves:
// out[a] = C+[a] + C-[a], out[a+64] = C+[a] - C-[a] for a in [0,64) -- the
// other side of the CRT split. See layout_defs.h.
//
// C+/C- come from one k_bucket_reduce.comp call over all 128 (both halves')
// outputs at once: C+[a] lives at index a, C-[a] at index a+64, of the same
// buffer, same L_CIRCULANT_SIZE-per-blob stride as every other reduce call.
#version 460
#extension GL_GOOGLE_include_directive : require
#include "field.glsl.inc"

layout(local_size_x = L_CIRCULANT_HALF, local_size_y = 1, local_size_z = 1) in;

layout(push_constant, std430) uniform PC {
    uint64_t outAddr;
    uint64_t reducedAddr;
} pc;

void main() {
    U32Buf outBuf = U32Buf(pc.outAddr);
    U32Buf reducedBuf = U32Buf(pc.reducedAddr);

    const uint a = gl_LocalInvocationID.x; // 0..63
    const uint b = gl_WorkGroupID.y;

    const G1 cp = g1_load(reducedBuf, (b * L_CIRCULANT_SIZE + a) * L_JACOBIAN_WORDS);
    const G1 cm = g1_load(reducedBuf, (b * L_CIRCULANT_SIZE + a + L_CIRCULANT_HALF) * L_JACOBIAN_WORDS);

    g1_store(outBuf, (b * L_CIRCULANT_SIZE + a) * L_JACOBIAN_WORDS, g1_add(cp, cm));
    g1_store(outBuf, (b * L_CIRCULANT_SIZE + a + L_CIRCULANT_HALF) * L_JACOBIAN_WORDS,
             g1_sub(cp, cm));
}
